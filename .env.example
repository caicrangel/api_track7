# ─────────────────────────────────────────────────────────────
# FleetGov · Plataforma de gestão de frota com telemetria Track7
# Copie para .env  ->  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Portas expostas no host
WEB_PORT=8080
API_PORT=3333
POSTGRES_PORT=5432
REDIS_PORT=6379

# Banco de dados
POSTGRES_USER=fleetgov
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=fleetgov
DATABASE_URL=postgres://fleetgov:troque-esta-senha@postgres:5432/fleetgov

# Cache / filas
REDIS_URL=redis://redis:6379

# Segurança (OBRIGATÓRIO trocar em produção)
# JWT_SECRET: string aleatória longa   -> openssl rand -hex 48
JWT_SECRET=troque-por-uma-chave-aleatoria-bem-longa-de-no-minimo-48-chars
# APP_ENCRYPTION_KEY: 32 bytes em base64 -> openssl rand -base64 32
APP_ENCRYPTION_KEY=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtMzJiIQ==
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Administrador criado automaticamente no primeiro boot
BOOTSTRAP_ORG_NAME=Prefeitura Municipal
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@fleetgov.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

# ─── Track7 (plataforma MiX Telematics) ───
# Estes valores também podem ser cadastrados pela tela Configurações > Integrações.
# O que estiver no .env é usado apenas para semear a configuração no primeiro boot.
TRACK7_IDENTITY_URL=https://identity.us.mixtelematics.com/core
TRACK7_API_URL=https://integrate.us.mixtelematics.com
TRACK7_SCOPE=offline_access MiX.Integrate
TRACK7_CLIENT_ID=
TRACK7_CLIENT_SECRET=
TRACK7_USERNAME=
TRACK7_PASSWORD=
# Opcional: id do grupo/organização na Track7. Em branco = descoberta automática.
TRACK7_ORGANISATION_ID=

# Sincronização automática
SYNC_ENABLED=true
SYNC_CRON=0 */6 * * *
SYNC_HISTORY_DAYS=7

# Front-end (build time)
VITE_API_URL=/api
NODE_ENV=production
TZ=America/Sao_Paulo
